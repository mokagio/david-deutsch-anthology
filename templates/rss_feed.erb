<?xml version="1.0" encoding="UTF-8" ?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd">
  <channel>
    <atom:link href="<%= h feed_url %>" rel="self" type="application/rss+xml" />
    <title><%= h feed_title %></title>
    <link><%= h site_url %></link>
    <description><%= h feed_description %></description>
    <language>en-us</language>
    <copyright>Each episode remains the property of the show that produced it.</copyright>
    <pubDate><%= build_date.rfc2822 %></pubDate>
    <lastBuildDate><%= build_date.rfc2822 %></lastBuildDate>
    <generator>david-deutsch-anthology</generator>
    <itunes:author><%= h feed_author %></itunes:author>
    <itunes:summary><%= h feed_description %></itunes:summary>
    <itunes:type>episodic</itunes:type>
    <itunes:explicit>false</itunes:explicit>
    <itunes:category text="Science">
      <itunes:category text="Natural Sciences" />
    </itunes:category>
    <itunes:category text="Society &amp; Culture">
      <itunes:category text="Philosophy" />
    </itunes:category>
<% episodes.each do |episode| -%>
    <item>
      <title><%= h episode[:title] %></title>
      <link><%= h episode[:page_url] %></link>
      <guid isPermaLink="false"><%= h episode[:guid] %></guid>
      <pubDate><%= episode[:published_at].rfc2822 %></pubDate>
      <description><%= h episode[:description] %></description>
      <enclosure url="<%= h episode[:audio_url] %>" type="<%= h episode[:type] %>" length="<%= episode[:length] %>" />
      <itunes:author><%= h episode[:show_name] %></itunes:author>
      <itunes:summary><%= h episode[:description] %></itunes:summary>
      <itunes:episodeType>full</itunes:episodeType>
      <itunes:explicit>false</itunes:explicit>
<% if episode[:duration] -%>
      <itunes:duration><%= h episode[:duration] %></itunes:duration>
<% end -%>
    </item>
<% end -%>
  </channel>
</rss>
