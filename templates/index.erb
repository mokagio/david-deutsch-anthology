<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The David Deutsch Anthology</title>
    <link rel="icon" href="favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.min.css">
    <style>
      /* The accent drifts through the colours of the cover art. A custom property
         has to be registered to be animatable: without `@property` the browser
         has no idea `--accent` holds a colour, and the keyframes snap instead of
         blending. Unregistered, it simply sits on the initial value. */
      @property --accent {
        syntax: "<color>";
        inherits: true;
        initial-value: oklch(0.672 0.113 300.3);
      }

      /* Every stop shares a lightness of ~0.67, which is what holds the contrast
         at 6:1 against the ground for the whole cycle, blends included. Change a
         hue freely; change an L and check it. */
      @keyframes drift {
        0%   { --accent: oklch(0.672 0.113 300.3); } /* nebula    */
        20%  { --accent: oklch(0.677 0.129 322.0); } /* orchid    */
        40%  { --accent: oklch(0.670 0.124  46.0); } /* ember     */
        60%  { --accent: oklch(0.670 0.076 288.6); } /* starlight */
        80%  { --accent: oklch(0.671 0.116 268.6); } /* cobalt    */
        100% { --accent: oklch(0.672 0.113 300.3); }
      }

      :root[data-theme="dark"] {
        animation: drift 60s linear infinite;
        --pico-background-color: #0F0E24;
        --pico-primary: var(--accent);
        --pico-primary-hover: var(--accent);
        --pico-primary-underline: color-mix(in oklab, var(--accent) 40%, transparent);
      }

      @media (prefers-reduced-motion: reduce) {
        :root[data-theme="dark"] { animation: none; }
      }

      h1, h2, h3 {
        font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
      }

      .portrait {
        float: right;
        /* Grows with the page, but never past a third of the column: further and
           the text wrapping beside it is a gutter rather than a paragraph. */
        width: clamp(200px, 26vw, 320px);
        margin: 0 0 1rem 1.5rem;
        border-radius: .5rem;
      }

      @media (max-width: 600px) {
        .portrait {
          float: none;
          display: block;
          width: min(52vw, 260px);
          margin: 0 auto 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <main>
    <img class="portrait" src="portrait.jpg" width="640" height="640" alt="David Deutsch">
    <p>This page collects <a href="https://www.daviddeutsch.org.uk/" target="_blank">David Deutsch's</a> books, talks, and interviews.</p>
    <p>A YouTube playlist with some of the interviews can be found <a href="https://www.youtube.com/watch?v=xdtssXITXuE&list=PLlL8eTHbJV9qJIq3kR-V_p9Mavg46pgXf" target="_blank">here</a>.</p>
    <p>A podcast feed with some of the interviews and talks can be found <a href="podcast.rss" target="_blank">here</a>.</p>
    <h1>Books</h1>
    <% books.each do |book| %>
      <p>
        <em><%= book['name'] %></em> (<%= book['published_year'] %>)
        -
        <% book['urls'].each_with_index do |url, index| %>
          <a href="<%= url['url'] %>" target="_blank"><%= url['title'] %></a><% unless index >= book['urls'].count - 1 %>,&nbsp;<% end %>
        <% end %>
      </p>
    <% end %>

    <!-- TODO
    <h1>Talks</h1>
    <ul>
      <% talks.each do |talk| %>
        <li>
          <strong><%= talk['title'] %></strong>
          <br>
          Delivered on: <%= talk['delivered_date'] %>
        <br>
        <a href="<%= talk['url'] %>" target="_blank">Watch</a>
        </li>
      <% end %>
    </ul>
    -->

    <h1>Podcast Interviews</h1>
    <ul>
      <% podcast_interviews.each do |podcast| %>
        <%
          url = podcast['url'] || podcast['youtube_url'] || podcast['podcast_url']
          next unless url
        %>
        <li>
          <em><a href="<%= url %>" target="_blank"><%= podcast['title'] %></a></em>
          on <a href="<%= podcast['show']['url'] %>" target="_blank"><%= podcast['show']['name'] %></a>
          (<%= podcast['published_date'] %>)
        </li>
      <% end %>
    </ul>

    <h1>Other</h1>
    <ul>
      <% other.each do |item| %>
        <li>
          <a href="<%= item['url'] %>" target="_blank"><%= item['name'] %></a>
        </li>
      <% end %>
    </ul>
    </main>
    <footer>
      <hr/>
      <p>Curated by <a href="https://giolodi.com" target="_blank">Gio Lodi</a>.</p>
      <p>Suggest new entries <a href="https://github.com/mokagio/david-deutsch-anthology" target="_blank">here</a>.</p>
    </footer>
  </body>
</html>
